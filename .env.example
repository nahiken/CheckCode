# WhyCode 运行时配置示例(提交到仓库,不含密钥)
# 真实配置请复制为 .env 并填入密钥(.env 已被 gitignore)

# === 协议族选择 ===
# openai(默认)= OpenAI 兼容 /chat/completions;anthropic = Anthropic Messages API(/v1/messages)
# 决定客户端实现与消息/工具序列化,**不影响**上层(内部事件表示是协议无关的)。
# LLM_PROVIDER=openai

# === DeepSeek(OpenAI 兼容接口,provider=openai 时的默认端点) ===
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# === Anthropic(provider=anthropic 时使用;优先用官方 SDK,未装则 httpx 手写) ===
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-4-6
# Anthropic 认证头版本(一般不用改)
# ANTHROPIC_VERSION=2023-06-01
# 安装官方 SDK(可选;不装则走内置 httpx 实现,接口与行为一致)
#   uv sync --extra anthropic

# === 通用(可覆盖 provider 专属变量,便于切换端点) ===
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# 推理模型标记(M10):置 1 表示所配模型输出 reasoning_content(思考通道)。
# 开启后请求体省略 temperature(部分推理模型不接受该参数)。
# 注意:是否真正产生「思考」取决于 provider/模型;且部分推理模型不支持 Function Calling。
# LLM_REASONING=0

# === Agent 运行时 ===
# 模型最大迭代轮次(ReAct 循环上限)
AGENT_MAX_STEPS=20
# 单次工具执行超时(秒)
TOOL_TIMEOUT=120
# 上下文窗口(消息数,压缩兜底)
# AGENT_CONTEXT_WINDOW=200
# token 水位预算(M9 W5):估算当前消息列表 token 超此值触发 compress_to_budget;
# 0 关闭 token 水位压缩(仅消息数兜底)
# AGENT_TOKEN_BUDGET=16000
# 同批工具调用并发上限(M13,默认 4):仅作用于**声明并发安全**的只读调用
# (Tool.parallel_safe,如 read_file/list_dir);写/命令类调用永远是串行屏障。
# 设 1 = 严格串行;结果回灌顺序始终等于模型调用顺序,与并发度无关。
# AGENT_MAX_CONCURRENCY=4
